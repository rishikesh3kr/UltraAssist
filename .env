# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-your-litellm-key-here

# Open WebUI Configuration
WEBUI_SECRET_KEY=your-super-secret-key-change-this
WEBUI_PORT=3001
USER_AGENT=UltraAssist
CORS_ALLOW_ORIGIN=http://localhost:3001

# RAG Service Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CACHE_DIR=.rag_cache

# RAG Similarity Thresholds (0.0 to 1.0)
CSV_SIMILARITY_THRESHOLD=0.3
PDF_SIMILARITY_THRESHOLD=0.3
WEB_SIMILARITY_THRESHOLD=0.3
HIGH_CONFIDENCE_THRESHOLD=0.4

# Data Loading Control
FORCE_REFRESH_DATA=false
AUTO_REFRESH_ON_FILE_CHANGE=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Web scraping control
FINANCE_WEB_URLS=https://www.incometaxindia.gov.in/Pages/tax-services/file-income-tax-return.aspx,https://www.paisabazaar.com/tax/income-tax-slabs/
ENABLE_WEB_SCRAPING=true
WEB_CACHE_MAX_AGE_HOURS=24

# Optional: Cross-Encoder Re-ranking
# Set to true to enable re-ranking (requires additional dependencies)
ENABLE_RERANKING=false
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: Caching Configuration
ENABLE_EMBEDDING_CACHE=true
ENABLE_RETRIEVAL_CACHE=true
EMBEDDING_CACHE_TTL_HOURS=720
RETRIEVAL_CACHE_TTL_HOURS=24

# Optional: LLM Fallback Configuration
ENABLE_LLM_FALLBACK=true
AUTO_SWITCH_TO_CLAUDE=true
AWS_CLAUDE_MODEL=claude-sonnet-4-20250514